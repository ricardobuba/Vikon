# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.uv/
build/
dist/

# Entornos / secretos
# `.env*` y no `.env` a secas: el día que haya un VPS aparecerá un .env.production
# con credenciales reales, y la regla anterior no lo habría cubierto.
.env*
!.env.example
*.local
secrets.*
*.pem
*.key

# Documentos de trabajo que NO se publican: llevan planificación fiscal, análisis
# de exposición jurídica, debilidades sin corregir y datos de terceros.
BLINDAJE_LEGAL_Plan.md
SALIDA_A_MERCADO_Plan.md

# Tooling de desarrollo local (launch config de Claude Code), no es parte del proyecto
.claude/

# Datos locales (nunca versionar streams ni exports de Strava)
data/
*.fit
*.gpx
*.tcx
# Exportación RGPD de la propia cuenta: lleva el historial de salud entero
vikon-mis-datos*.json

# Herramientas
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.log
*.sql
*.sql.gz
*.dump

# SO / editor
.DS_Store
Thumbs.db
