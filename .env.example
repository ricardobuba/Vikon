# Copia este fichero a `.env` y rellena los valores.  `.env` está en .gitignore.
# Todo lo que lleva valor por defecto puedes dejarlo sin tocar.

# --- Base de datos (coincide con docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://cc:cc@localhost:5432/cycling_coach

# --- Strava API ---
# Crea una app en https://www.strava.com/settings/api
#   - "Authorization Callback Domain" debe ser exactamente:  localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Puerto del servidor local que captura el 'code' de OAuth (loopback).
# El redirect_uri será http://localhost:<OAUTH_PORT>/callback
OAUTH_PORT=8721

# --- Capa conversacional (opcional: sin clave, el chat te guía en vez de fallar) ---
# El cliente es agnóstico del proveedor: vale cualquier endpoint compatible con
# OpenAI. La clave se acepta también como GEMINI_API_KEY, GROQ_API_KEY, etc.
#   Gemini:    https://generativelanguage.googleapis.com/v1beta/openai
#   Groq:      https://api.groq.com/openai/v1
#   OpenRouter https://openrouter.ai/api/v1
#   Ollama:    http://localhost:11434/v1   (local, sin clave)
#   Anthropic: https://api.anthropic.com/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.4

# --- Sincronización automática con Strava mientras el servidor corre ---
# Segundos entre sincronizaciones. 0 = desactivada.
SYNC_INTERVAL_S=900

# --- Retención de datos ---
# Días que se conservan las series temporales crudas. Bajarlo se acerca a la
# caché de 7 días que pide la API Policy de Strava (§6.2), pero apaga el detalle
# por zonas del histórico. Ver src/cycling_coach/retention.py.
STREAM_RETENTION_DAYS=365

# --- Acceso y seguridad ---
# PESTILLO: si el login te deja fuera, pon AUTH_ENABLED=false y entras sin él.
# Solo funciona con una única cuenta creada; con más, falla cerrado a propósito.
AUTH_ENABLED=true

# Cookie de sesión solo por HTTPS. Déjalo en false mientras sirvas por HTTP en
# la LAN (si no, el navegador descarta la cookie). Ponlo a true al tener HTTPS.
COOKIE_SECURE=false

# Documentación interactiva de la API en /api/docs. Útil en desarrollo;
# publicada, es regalar el mapa de endpoints.
API_DOCS=true
